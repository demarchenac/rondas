{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "store",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_APP_VARIANT": "preview"
      }
    },
    "apk": {
      "distribution": "internal",
      "channel": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "appleId": "crdemar@gmail.com",
        "ascAppId": "6769171853",
        "appleTeamId": "8562MMJNFH"
      }
    },
    "production": {
      "ios": {
        "appleId": "crdemar@gmail.com",
        "ascAppId": "6761865170",
        "appleTeamId": "8562MMJNFH"
      }
    }
  }
}
