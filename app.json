{
  "expo": {
    "name": "Rondas",
    "slug": "rondas",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rondas",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rondas.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Rondas necesita acceso a la cámara para escanear recibos y extraer los ítems automáticamente.",
        "NSPhotoLibraryUsageDescription": "Rondas accede a tus fotos para escanear recibos guardados en tu galería.",
        "NSPhotoLibraryAddUsageDescription": "Rondas guarda los resúmenes generados (infografías) en tu galería de fotos.",
        "NSContactsUsageDescription": "Rondas usa tus contactos para asignar personas a los ítems de la cuenta y compartir el resumen por WhatsApp.",
        "NSLocationWhenInUseUsageDescription": "Rondas usa tu ubicación para identificar automáticamente el lugar donde fue hecha la cuenta."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "app.rondas.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "108dace2-7c2f-4aad-8a3f-d8695905f5d8"
      }
    },
    "owner": "demarchenac"
  }
}
